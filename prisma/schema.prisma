generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GatewaySettlement {
  id             String   @id @default(uuid())
  recordId       String   @unique // Correlation ID (e.g. REC-001)
  txnId          String   // Gateway transaction ID (e.g. pay_N1x892a)
  orderId        String   // Merchant order ID (e.g. ord_77192)
  amount         Float    // Transaction total amount
  fee            Float    // Gateway fee deducted
  settledAmount  Float    // Net settled amount (amount - fee)
  utr            String?  // Unique Transaction Reference (bank payout ref)
  settlementDate String   // ISO date string
  createdAt      DateTime @default(now())
}

model BankStatement {
  id             String   @id @default(uuid())
  recordId       String?  // Optional correlation ID
  utr            String?  // UTR number from bank credit advice
  creditedAmount Float    // Amount credited to bank account
  valueDate      String   // Value date of credit
  description    String   // Bank narration / remark
  createdAt      DateTime @default(now())
}

model LedgerEntry {
  id             String   @id @default(uuid())
  recordId       String   @unique // Correlation ID
  orderId        String   // Internal Order ID
  txnId          String?  // Associated payment transaction ID
  expectedAmount Float    // Amount expected from order
  orderDate      String   // Order placement date
  status         String   // e.g., PAID, PENDING, CANCELLED
  createdAt      DateTime @default(now())
}

model GroundTruthLabel {
  id              String   @id @default(uuid())
  recordId        String   @unique // Correlation ID
  txnId           String?
  orderId         String?
  utr             String?
  expectedStatus  String   // "matched" | "matched_with_variance" | "exception"
  discrepancyType String?  // null | "amount_mismatch" | "missing_utr" | "duplicate" | "timing_gap" | "unmatched"
  varianceAmount  Float?   // Known injected variance if any
  notes           String?  // Human explanation of ground truth
  createdAt       DateTime @default(now())
}

model ReconciliationLog {
  id                 String   @id @default(uuid())
  batchId            String   // Identifier for reconciliation run
  recordId           String   // Correlation ID
  txnId              String?
  orderId            String?
  utr                String?
  status             String   // "matched" | "matched_with_variance" | "exception"
  confidenceScore    Float    // 0.0 to 1.0 confidence
  rulesFired         String   // JSON string array of rule names applied
  candidateRecords   String   // JSON string of inputs from 3 sources
  geminiReasoning    String?  // Plain-English AI root cause analysis
  groundTruthStatus  String?  // Ground truth status for comparison
  isCorrect          Boolean? // Was agent prediction equal to ground truth?
  createdAt          DateTime @default(now())
}

model ReconciliationMetrics {
  id                String   @id @default(uuid())
  batchId           String   @unique
  totalRecords      Int
  matchedCount      Int
  varianceCount     Int
  exceptionCount    Int
  matchRate         Float    // Percentage (0-100)
  precision         Float    // Percentage (0-100)
  recall            Float    // Percentage (0-100)
  falsePositiveRate Float    // Percentage (0-100)
  f1Score           Float    // Percentage (0-100)
  discrepancyMatrix String   // JSON string breakdown by discrepancy type
  runTimestamp      DateTime @default(now())
}

model UserSubscription {
  id                     String    @id @default(uuid())
  userId                 String    @default("usr_default")
  planId                 String    // "starter" | "pro" | "enterprise"
  planName               String    // "Starter Plan" | "Pro Plan" | "Enterprise Plan"
  status                 String    // "active" | "canceled" | "past_due" | "pending"
  amount                 Float     // Amount in INR
  currency               String    @default("INR")
  razorpayOrderId        String?   // Razorpay order ID (e.g. order_9A33X5)
  razorpayPaymentId      String?   // Razorpay payment ID (e.g. pay_2910AA)
  razorpaySignature      String?   // Signature for verification
  razorpaySubscriptionId String?   // Razorpay subscription ID (e.g. sub_9A33X5)
  currentPeriodEnd       DateTime
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model EngineSettings {
  id                String   @id @default("default_settings")
  amountTolerance   Float    @default(0.0)  // Amount variance threshold in INR
  dateToleranceDays Int      @default(3)    // Date timing gap SLA threshold
  enableGeminiAI    Boolean  @default(true) // Toggle Gemini AI exception reasoning
  updatedAt         DateTime @updatedAt
}
